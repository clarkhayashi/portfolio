---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import StatusLabel from "./StatusLabel.astro";

interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
  lane?: string;
  proof?: string;
  href?: string;
  external?: boolean;
  statusLabel: string;
  statusType?: "progress" | "building" | "private";
  /** Real artifact from the work. Rows without one render with no thumbnail. */
  thumb?: { src: ImageMetadata; alt: string };
}

const {
  number,
  title,
  description,
  tags,
  lane,
  proof,
  href,
  external,
  statusLabel,
  statusType,
  thumb,
} = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  {...href ? { href } : {}}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  class="group block border-t border-ink/10 py-9 md:py-11"
>
  {
    /* The right rail is a FIXED width, not auto. Each row is its own grid, so an
       auto column resolves to a different width per row and the thumbnails no
       longer line up down the page. 19rem fits the longest status label without
       wrapping (StatusLabel is whitespace-nowrap). */
  }
  <div class="grid gap-3 md:grid-cols-[3.5rem_1fr_19rem] md:gap-6">
    <span class="select-none font-serif text-3xl font-bold leading-none text-bark/25 md:text-4xl">{number}</span>
    <div>
      {
        lane && (
          <p class="mb-1.5 text-xs font-medium uppercase tracking-[0.14em] text-bark">
            {lane}
          </p>
        )
      }
      <h3 class="font-sans text-[1.35rem] font-bold leading-snug tracking-[-0.015em] md:text-2xl">
        <span class:list={[href && "transition-colors group-hover:text-teal"]}>{title}</span>
        {
          href && (
            <span
              class="ml-2 inline-block -translate-x-1 text-teal opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100"
              aria-hidden="true"
            >
              →
            </span>
          )
        }
      </h3>
      <p class="mt-2 max-w-[58ch] leading-relaxed text-ink/70">
        {description}
      </p>
      {
        proof && (
          <p class="mt-2.5 text-sm font-medium text-bark">
            {proof}
          </p>
        )
      }
      <p class="mt-2 text-sm text-ink/65">{tags.join(" · ")}</p>
    </div>
    {
      /* Status sits above the artifact. Rows with no genuine artifact simply
         render the status and no image, never a stand-in. */
    }
    <div class="md:pt-1.5">
      <StatusLabel label={statusLabel} type={statusType} />
      {
        thumb && (
          <Picture
            src={thumb.src}
            alt={thumb.alt}
            formats={["avif", "webp"]}
            widths={[304, 480, 608, 912]}
            sizes="(min-width: 768px) 19rem, calc(100vw - 3rem)"
            loading="lazy"
            decoding="async"
            class="mt-3 aspect-[16/10] w-full rounded-lg border border-ink/10 object-cover transition-[border-color] duration-200 ease-[var(--ease-out)] group-hover:border-teal/40"
          />
        )
      }
    </div>
  </div>
</Tag>
