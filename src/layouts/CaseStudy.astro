---
import Base from "./Base.astro";
import StatusLabel from "../components/StatusLabel.astro";

const { frontmatter } = Astro.props;
/* Accent faces are recorded in front matter, never felt. `accent: slab`
   (currently the intramural study only) sets the headline in Bespoke Slab;
   everything else on the page stays Core. Ceiling of three accents site-wide. */
const titleFont = frontmatter.accent === "slab" ? "font-slab" : "font-serif";
---

<Base title={`${frontmatter.title} · Clark Hayashi`} description={frontmatter.summary}>
  <article class="mx-auto max-w-[70ch] px-6 pb-10 pt-10 md:pt-16">
    <a href="/work" class="text-sm font-medium text-teal-deep transition-colors hover:text-ink"
      >← All work</a
    >
    <div class="mt-8">
      <StatusLabel label={frontmatter.statusLabel} type={frontmatter.statusType} />
    </div>
    <h1
      class:list={[
        /* 46px is the second step of the nine-step scale; 48 was off-scale. */
        "mt-4 text-[2.125rem] font-bold leading-[1.08] tracking-[-0.024em] md:text-[2.875rem] md:leading-[1.04]",
        titleFont,
      ]}
    >
      {frontmatter.title}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-ink/70">{frontmatter.summary}</p>
    <p class="mt-4 text-sm text-ink/65">{frontmatter.tags?.join(" · ")}</p>

    <div class="case-body mt-6">
      <slot />
    </div>
  </article>
</Base>
