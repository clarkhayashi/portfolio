---
import Base from "../layouts/Base.astro";
import spotify from "../data/spotify/overview.json";

/* Rendered at build time from the streaming export, so the card still states
   something true when the live API is unreachable. */
const spotifyHours = new Intl.NumberFormat("en-US").format(
  Math.round(spotify.hours),
);
/* Rounded, not floored. The span is 3.87 years, and flooring it to "3" both
   undersells the record and contradicts the "Four years" on the page this
   card links to. */
const spotifyYears = Math.round(
  (Date.parse(spotify.last_play) - Date.parse(spotify.first_play)) /
    (365.25 * 86400000),
);
---

<Base
  title="Side Quests · Clark Hayashi"
  description="Clark Hayashi's reading notes, Japanese learning, movement, and small experiments."
>
  {/* Base.astro already provides the page's single <main> landmark. */}
  <div class="quests-shell">
    <section class="quests-intro" aria-labelledby="side-quests-title">
      <h1 id="side-quests-title">Side Quests</h1>
      <p class="intro-copy">
        Side quests that <em>keep me going</em>
      </p>
    </section>

    <section class="quest-grid" aria-label="Clark's side quests">
      <a
        class="quest-card duo-card"
        href="https://www.duolingo.com/profile/ClarkHayashi"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        <div class="duo-copy">
          {/* Both states have to read as finished sentences. The fallback used
              to be an empty number span next to the word "public profile",
              which rendered as a fragment where a stat belongs and looked like
              a number that failed to load rather than a deliberate fallback.
              On success the script fills the number and swaps the label to
              "day streak". */}
          <p class="duo-streak">
            <span id="duo-streak-number"></span>
            <span id="duo-streak-label">View Duolingo profile</span>
          </p>
          <h2>My Duolingo</h2>
        </div>

        <div class="duo-meta" aria-live="polite">
          <span id="duo-course">Japanese</span>
          <span aria-hidden="true">·</span>
          <span id="duo-xp">Live stats when available</span>
        </div>

        <img
          class="duo-avatar"
          src="/duolingo-clark.svg"
          alt="Clark's Duolingo avatar"
          width="670"
          height="563"
        />
      <p class="card-reveal">I love learning languages, gotta keep up with my Japanese. Getting 1% better every day.</p>

      </a>

      <a
        class="quest-card notes-card"
        href="https://clarkhayashi.github.io/my-websites/clark-reading-notes/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        <div class="notes-copy">
          <h2>Reading Notes</h2>
          <p>
            Books and ideas worth keeping, in print and on audio, connected in
            my own words
          </p>
        </div>

        <p class="card-reveal">What I read and listen to becomes what I’m thinking about.</p>

        <span class="card-action">Open my notes ↗</span>
      </a>

      <a
        class="quest-card spotify-card"
        href="/side-quests/listening"
      >
        <div class="spotify-copy">
          <p class="spotify-headline">
            <span>{spotifyHours}</span> hours
          </p>
          <h2>Listening</h2>
          <p>
            {spotifyYears} years of my own Spotify history, counted from the raw
            export rather than taken from a year end summary
          </p>
        </div>

        {
          /* Filled by the /api/spotify-now function. The slot stays empty
             rather than showing a placeholder cover, so a Spotify outage
             degrades to plain text instead of a broken image. */
        }
        <div class="spotify-live" data-spotify-live hidden>
          <div class="spotify-art" data-spotify-art aria-hidden="true"></div>
          <div class="spotify-meta">
            <span class="spotify-status" data-spotify-status></span>
            <span class="spotify-track" data-spotify-track></span>
          </div>
        </div>

        <p class="card-reveal">{spotifyHours} hours counted from my own raw export, because who needs to wait for Spotify Wrapped.</p>

        <span class="card-action">See the stats →</span>
      </a>

      <article
        class="quest-card strava-card"
      >
        <div class="strava-rotator" data-strava-rotator>
          <div class="strava-embed-shell" data-strava-slide data-active="true">
            <div
              class="strava-embed-placeholder"
              data-embed-type="activity"
              data-embed-id="19068024693"
              data-style="standard"
              data-from-embed="false"
              data-token="-vrpW4WL_5ZYnKOmhaa9H965qt9_m3zvr0zWO2qcltU"
            ></div>
          </div>
          <div class="strava-embed-shell" data-strava-slide>
            <div
              class="strava-embed-placeholder"
              data-embed-type="activity"
              data-embed-id="19463140435"
              data-style="standard"
              data-from-embed="false"
              data-token="lPI5kCxxDdxtsthrC3nX2ga7yMSOMq4a35NwlJC67KU"
            ></div>
          </div>
        </div>

        <div class="strava-dots" role="tablist" aria-label="Recent activities">
          <button type="button" role="tab" aria-selected="true" aria-label="Activity 1" data-strava-dot></button>
          <button type="button" role="tab" aria-selected="false" aria-label="Activity 2" data-strava-dot></button>
        </div>

      <p class="card-reveal">My recent activity, straight from my Strava.</p>
      </article>

      <a
        class="quest-card github-card"
        href="https://github.com/clarkhayashi"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        {
          /* "Job's not finished" sits where the code window used to, so the
             card keeps exactly one decorative element. Decorative, so it is
             hidden from assistive tech and taken out of the tab order; the
             GIF cannot be paused inside a third-party frame, so readers who
             ask for reduced motion get the quiet code window instead. */
        }
        <div class="gif-frame" aria-hidden="true">
          <iframe
            src="https://giphy.com/embed/QGZBpodY7Kdtw99y04"
            title="Kobe Bryant: job's not finished"
            class="giphy-embed"
            loading="lazy"
            tabindex="-1"
            frameborder="0"></iframe>
        </div>

        <div class="code-window" aria-hidden="true">
          <div class="code-dots"><i></i><i></i><i></i></div>
          <span class="code-line line-one"></span>
          <span class="code-line line-two"></span>
          <span class="code-line line-three"></span>
          <span class="code-line line-four"></span>
        </div>

        <div class="github-copy">
          <h2>Build to learn</h2>
          <p>Prototypes, useful tools, and rabbit holes with a commit history</p>
        </div>

        <p class="card-reveal">“If you want to be great in a particular area, you have to obsess over it.” Kobe Bryant</p>

        <span class="card-action">Browse GitHub ↗</span>
      </a>
    </section>
  </div>

</Base>

<script is:inline async src="https://strava-embeds.com/embed.js"></script>

<script>
  /* Strava activities rotate every 8s. Pauses on hover/focus so a reader can
     finish looking, and honours reduced motion by staying on the first one. */
  (() => {
    const rotator = document.querySelector("[data-strava-rotator]");
    if (!rotator) return;
    const slides = [...rotator.querySelectorAll("[data-strava-slide]")];
    const dots = [...document.querySelectorAll("[data-strava-dot]")];
    if (slides.length < 2) return;

    let current = 0;
    let timer = 0;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function show(next) {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) =>
        i === current
          ? slide.setAttribute("data-active", "true")
          : slide.removeAttribute("data-active"),
      );
      dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === current ? "true" : "false"));
    }

    function start() {
      if (reduced || timer) return;
      timer = setInterval(() => show(current + 1), 8000);
    }
    function stop() {
      clearInterval(timer);
      timer = 0;
    }

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        stop();
        start();
      }),
    );

    const card = rotator.closest(".strava-card");
    card?.addEventListener("pointerenter", stop);
    card?.addEventListener("pointerleave", start);
    card?.addEventListener("focusin", stop);
    card?.addEventListener("focusout", start);

    start();
  })();

  const compactNumber = new Intl.NumberFormat("en-US", {
    notation: "compact",
    maximumFractionDigits: 1,
  });

  const streakNumber = document.querySelector("#duo-streak-number");
  const streakLabel = document.querySelector("#duo-streak-label");
  const courseName = document.querySelector("#duo-course");
  const courseXp = document.querySelector("#duo-xp");

  fetch("/api/duolingo")
    .then((response) => {
      if (!response.ok) throw new Error("Profile unavailable");
      return response.json();
    })
    .then((profile) => {
      if (streakNumber && Number.isFinite(profile.streak)) {
        streakNumber.textContent = String(profile.streak);
        streakLabel.textContent = "day streak";
      }

      if (courseName && profile.course?.title) {
        courseName.textContent = profile.course.title;
      }

      const xp = profile.course?.xp ?? profile.totalXp;
      if (courseXp && Number.isFinite(xp)) {
        courseXp.textContent = `${compactNumber.format(xp)} XP`;
      }
    })
    .catch(() => {
      // The public profile link remains the intentional fallback.
    });

  /* Spotify strip on the listening card. The card reads fine without it, so
     every failure path simply leaves the strip hidden. */
  const spotifyLive = document.querySelector("[data-spotify-live]");
  const spotifyArt = document.querySelector("[data-spotify-art]");
  const spotifyStatus = document.querySelector("[data-spotify-status]");
  const spotifyTrack = document.querySelector("[data-spotify-track]");

  const relativeTime = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" });

  function relativeFrom(isoString) {
    const then = new Date(isoString ?? "").getTime();
    if (Number.isNaN(then)) return "recently";

    const minutes = Math.round((then - Date.now()) / 60000);
    if (Math.abs(minutes) < 60) return relativeTime.format(minutes, "minute");

    const hours = Math.round(minutes / 60);
    if (Math.abs(hours) < 24) return relativeTime.format(hours, "hour");

    return relativeTime.format(Math.round(hours / 24), "day");
  }

  fetch("/api/spotify-now")
    .then((response) => {
      if (!response.ok) throw new Error("Spotify unavailable");
      return response.json();
    })
    .then((data) => {
      const playing = data.nowPlaying;
      const latest = data.recentlyPlayed?.[0];
      const track = playing ?? latest;
      if (!track || !spotifyLive) return;

      spotifyStatus.textContent = playing
        ? "Playing now"
        : `Last played ${relativeFrom(latest.playedAt)}`;

      /* textContent, not innerHTML: track and artist names are third-party
         strings and some contain angle brackets. */
      spotifyTrack.textContent = `${track.title} · ${track.artist}`;

      if (spotifyArt && track.art?.small) {
        const cover = document.createElement("img");
        cover.src = track.art.small;
        cover.alt = "";
        cover.width = 48;
        cover.height = 48;
        cover.loading = "lazy";
        spotifyArt.replaceChildren(cover);
      }

      spotifyLive.hidden = false;
    })
    .catch(() => {
      // The card still explains itself and still links to the stats page.
    });

</script>

<style>
  /* DESIGN.md: no gradients, and paper is #F7F4EF everywhere. This page used
     to paint its own near-miss paper plus a teal radial wash, which
     made the header hairline visibly change tone between pages. */

  .quests-shell {
    /* 1000px container, same as every other page including About. */
    width: min(1000px, calc(100% - 3rem));
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .quests-intro {
    max-width: none;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* Page title, 34 mobile / 56 desktop, left-aligned like /work and /journey.
     This is the page's single Zodiak moment; nothing below it is serif. */
  .quests-intro h1 {
    margin: 0;
    color: var(--color-ink, #1c1c1c);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 2.125rem;
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.04;
  }

  .intro-copy {
    max-width: 52ch;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ink, #1c1c1c) 70%, transparent);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* Satoshi's drawn italic, not a second serif: the serif accent is spent. */
  .intro-copy em {
    color: var(--color-teal-deep, #4f7773);
    font-style: italic;
  }

  @media (min-width: 768px) {
    .quests-intro h1 { font-size: 3.5rem; }
  }

  .quest-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  /* Flat, per DESIGN.md: hairline plus rounded corner carries the structure.
     The 20/45px drop shadow and the inset white highlight are gone, and the
     hover lift with them; the border going teal is the whole hover. */
  .quest-card {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink, #1c1c1c) 10%, transparent);
    border-radius: 16px;
    color: var(--color-ink, #1c1c1c);
    text-decoration: none;
    transition: border-color 180ms var(--ease-out);
  }

  .quest-card:hover {
    border-color: color-mix(in srgb, var(--color-teal, #5d8c88) 45%, transparent);
  }

  /* ---------- Hover reveal ----------
     The description lives in the card, at readable size, instead of in a small
     label chasing the cursor. The old tooltip was gated to (pointer: fine) and
     min-width 769px, which meant every phone visitor saw none of this copy.

     Licensed expression: DESIGN.md sanctions Side Quests as an expressive
     surface, so the lift and the tinted shadow below are deliberate here and
     nowhere else. The shadow is mixed from ink, never pure black on paper. */
  .card-reveal {
    margin: 0.85rem 0 0;
    max-width: 40ch;
    color: color-mix(in srgb, var(--color-ink, #1c1c1c) 72%, transparent);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .quest-card {
      transition:
        border-color 180ms var(--ease-out),
        transform 180ms var(--ease-out),
        box-shadow 180ms var(--ease-out);
    }

    .quest-card:hover,
    .quest-card:focus-within {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px
        color-mix(in srgb, var(--color-ink, #1c1c1c) 12%, transparent);
    }

    .card-reveal {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 200ms var(--ease-out),
        transform 200ms var(--ease-out);
    }

    /* focus-within so the reveal is reachable by keyboard, not just by mouse. */
    .quest-card:hover .card-reveal,
    .quest-card:focus-within .card-reveal {
      opacity: 1;
      transform: none;
    }
  }

  /* No hover on a phone, so the copy is simply always there. This is the
     branch that carries the content for roughly half the traffic. */
  @media (hover: none) {
    .card-reveal {
      opacity: 1;
      transform: none;
    }
  }

  .quest-card:focus-visible,
  .quest-card a:focus-visible {
    outline: 2px solid var(--color-teal, #5d8c88);
    outline-offset: 3px;
  }

  .external-mark {
    position: absolute;
    z-index: 5;
    top: clamp(1.15rem, 2.5vw, 1.6rem);
    right: clamp(1.15rem, 2.5vw, 1.6rem);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.9rem;
    opacity: 0.5;
  }

  .duo-card {
    grid-column: span 7;
    background: var(--color-paper, #f7f4ef);
  }

  .duo-copy {
    position: relative;
    z-index: 3;
    width: 52%;
    align-self: flex-end;
    padding: 4rem 0 3rem clamp(1.4rem, 3vw, 2.2rem);
  }

  .duo-streak {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
  }

  /* Ink at the 46px display step, Satoshi 900. Was #e2472f at weight 850. */
  #duo-streak-number {
    color: var(--color-ink, #1c1c1c);
    font-size: 2.875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* Was 12.8px tracked uppercase in #e2472f, which is 3.70:1 on paper and
     fails WCAG AA. Sentence case at the label spec (13px / 500 / teal-deep,
     4.54:1) matches every other label on the site. */
  #duo-streak-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-teal-deep, #4f7773);
  }

  /* Card titles are Satoshi 900 at the 26/34 steps, not Zodiak: the page's
     one serif moment is the page title. Was clamp(32px, 4vw, 52px) Zodiak. */
  .duo-copy h2,
  .notes-copy h2,
  .spotify-copy h2,
  .github-copy h2 {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .duo-copy > p:last-child,
  .notes-copy p,
  .spotify-copy p,
  .github-copy p {
    margin: 0.85rem 0 0;
    /* 70% ink, not opacity 0.68 on a navy: 0.68 landed under the 65% ink
       contrast floor DESIGN.md sets for text that carries information. */
    color: color-mix(in srgb, var(--color-ink, #1c1c1c) 70%, transparent);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .duo-copy h2,
    .notes-copy h2,
    .spotify-copy h2,
    .github-copy h2 { font-size: 2.125rem; }
  }

  /* The avatar is a PNG with its own grey plate baked in, so it is framed as
     a rounded tile rather than bled off the card edge: against paper the
     plate would otherwise read as a stray grey rectangle. */
  .duo-avatar {
    position: absolute;
    z-index: 1;
    right: clamp(1.4rem, 3vw, 2.2rem);
    bottom: clamp(1.4rem, 3vw, 2.2rem);
    width: 46%;
    height: auto;
    border-radius: 8px;
    object-fit: contain;
    transform-origin: bottom center;
    animation: duo-float 5.5s ease-in-out infinite;
  }

  /* Solid paper, no backdrop blur: translucent-blur chips are the
     glassmorphism direction CLAUDE.md rejects. */
  .duo-meta {
    position: absolute;
    z-index: 4;
    right: 1.3rem;
    bottom: 1.1rem;
    display: flex;
    gap: 0.35rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-ink, #1c1c1c) 12%, transparent);
    border-radius: 999px;
    background: var(--color-paper, #f7f4ef);
    color: var(--color-ink, #1c1c1c);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .notes-card {
    grid-column: span 5;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--color-paper, #f7f4ef);
  }

  .notes-copy {
    position: relative;
    z-index: 2;
    max-width: 27rem;
    padding-bottom: 3.4rem;
  }

  .card-action {
    position: absolute;
    right: clamp(1.4rem, 3vw, 2.2rem);
    bottom: clamp(1.4rem, 3vw, 2rem);
    left: clamp(1.4rem, 3vw, 2.2rem);
    color: var(--color-teal-deep, #4f7773);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .spotify-card {
    grid-column: span 12;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--color-paper, #f7f4ef);
  }

  .spotify-copy {
    max-width: 34rem;
  }

  /* Mirrors the Duolingo card's streak treatment so the two live-data cards
     read as a pair, in teal rather than that card's red. */
  .spotify-headline {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
    color: var(--color-teal-deep, #4f7773);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .spotify-headline span {
    color: var(--color-ink, #1c1c1c);
    font-size: 2.875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* Sits above the absolutely positioned card action, hence the bottom
     padding rather than a margin on the action itself. */
  .spotify-live {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.5rem;
    padding-bottom: 3.4rem;
  }

  .spotify-art {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-ink, #1c1c1c) 6%, transparent);
  }

  .spotify-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotify-meta {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spotify-status {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-teal-deep, #4f7773);
  }

  .spotify-track {
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .strava-card {
    grid-column: span 12;
    height: 780px;
    min-height: 780px;
    background: var(--color-paper, #f7f4ef);
  }

  .strava-rotator {
    position: absolute;
    inset: 0;
  }

  .strava-embed-shell {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-paper, #f7f4ef);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease-out, ease), visibility 0.5s;
  }

  .strava-embed-shell[data-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  .strava-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    z-index: 3;
    display: flex;
    gap: 9px;
    transform: translateX(-50%);
  }

  .strava-dots button {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .strava-dots button::before {
    content: "";
    width: 7px;
