---
import Base from "../layouts/Base.astro";
import spotify from "../data/spotify/overview.json";

/* Rendered at build time from the streaming export, so the card still states
   something true when the live API is unreachable. */
const spotifyHours = new Intl.NumberFormat("en-US").format(
  Math.round(spotify.hours),
);
/* Rounded, not floored. The span is 3.87 years, and flooring it to "3" both
   undersells the record and contradicts the "Four years" on the page this
   card links to. */
const spotifyYears = Math.round(
  (Date.parse(spotify.last_play) - Date.parse(spotify.first_play)) /
    (365.25 * 86400000),
);
---

<Base
  title="Side Quests · Clark Hayashi"
  description="Clark Hayashi's reading notes, Japanese learning, movement, and small experiments."
>
  <main class="quests-shell">
    <section class="quests-intro" aria-labelledby="side-quests-title">
      <h1 id="side-quests-title">Side Quests</h1>
      <p class="intro-copy">
        Side quests that <em>keep me going</em>
      </p>
    </section>

    <section class="quest-grid" aria-label="Clark's side quests">
      <a
        class="quest-card duo-card"
        href="https://www.duolingo.com/profile/ClarkHayashi"
        target="_blank"
        rel="noopener noreferrer"
        data-tooltip="I love learning. Japanese is my main focus, with chess and five other languages on the side · Follow me on Duolingo"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        <div class="duo-copy">
          <p class="duo-streak">
            <span id="duo-streak-number">—</span>
            <span id="duo-streak-label">public profile</span>
          </p>
          <h2>My Duolingo</h2>
        </div>

        <div class="duo-meta" aria-live="polite">
          <span id="duo-course">Japanese</span>
          <span aria-hidden="true">·</span>
          <span id="duo-xp">Live stats when available</span>
        </div>

        <img
          class="duo-avatar"
          src="/duolingo-clark.svg"
          alt="Clark's Duolingo avatar"
          width="670"
          height="563"
        />
      </a>

      <a
        class="quest-card notes-card"
        href="https://clarkhayashi.github.io/my-websites/clark-reading-notes/"
        target="_blank"
        rel="noopener noreferrer"
        data-tooltip="What I read and listen to becomes what I’m thinking about"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        <div class="notes-copy">
          <h2>Reading Notes</h2>
          <p>
            Books and ideas worth keeping, in print and on audio, connected in
            my own words
          </p>
        </div>

        <span class="card-action">Open my notes ↗</span>
      </a>

      <a
        class="quest-card spotify-card"
        href="/side-quests/listening"
        data-tooltip="What I have on, pulled live from my own Spotify account · Open the stats"
      >
        <div class="spotify-copy">
          <p class="spotify-headline">
            <span>{spotifyHours}</span> hours
          </p>
          <h2>Listening</h2>
          <p>
            {spotifyYears} years of my own Spotify history, counted from the raw
            export rather than taken from a year end summary
          </p>
        </div>

        {
          /* Filled by the /api/spotify-now function. The slot stays empty
             rather than showing a placeholder cover, so a Spotify outage
             degrades to plain text instead of a broken image. */
        }
        <div class="spotify-live" data-spotify-live hidden>
          <div class="spotify-art" data-spotify-art aria-hidden="true"></div>
          <div class="spotify-meta">
            <span class="spotify-status" data-spotify-status></span>
            <span class="spotify-track" data-spotify-track></span>
          </div>
        </div>

        <span class="card-action">See the stats →</span>
      </a>

      <article
        class="quest-card strava-card"
        data-tooltip="My recent activity · Open on Strava"
      >
        <div class="strava-rotator" data-strava-rotator>
          <div class="strava-embed-shell" data-strava-slide data-active="true">
            <div
              class="strava-embed-placeholder"
              data-embed-type="activity"
              data-embed-id="19068024693"
              data-style="standard"
              data-from-embed="false"
              data-token="-vrpW4WL_5ZYnKOmhaa9H965qt9_m3zvr0zWO2qcltU"
            ></div>
          </div>
          <div class="strava-embed-shell" data-strava-slide>
            <div
              class="strava-embed-placeholder"
              data-embed-type="activity"
              data-embed-id="19463140435"
              data-style="standard"
              data-from-embed="false"
              data-token="lPI5kCxxDdxtsthrC3nX2ga7yMSOMq4a35NwlJC67KU"
            ></div>
          </div>
        </div>

        <div class="strava-dots" role="tablist" aria-label="Recent activities">
          <button type="button" role="tab" aria-selected="true" aria-label="Activity 1" data-strava-dot></button>
          <button type="button" role="tab" aria-selected="false" aria-label="Activity 2" data-strava-dot></button>
        </div>

      </article>

      <a
        class="quest-card github-card"
        href="https://github.com/clarkhayashi"
        target="_blank"
        rel="noopener noreferrer"
        data-tooltip="Small builds, experiments, and code I wanted to understand"
      >
        <span class="external-mark" aria-hidden="true">↗</span>

        {
          /* "Job's not finished" sits where the code window used to, so the
             card keeps exactly one decorative element. Decorative, so it is
             hidden from assistive tech and taken out of the tab order; the
             GIF cannot be paused inside a third-party frame, so readers who
             ask for reduced motion get the quiet code window instead. */
        }
        <div class="gif-frame" aria-hidden="true">
          <iframe
            src="https://giphy.com/embed/QGZBpodY7Kdtw99y04"
            title="Kobe Bryant: job's not finished"
            class="giphy-embed"
            loading="lazy"
            tabindex="-1"
            frameborder="0"></iframe>
        </div>

        <div class="code-window" aria-hidden="true">
          <div class="code-dots"><i></i><i></i><i></i></div>
          <span class="code-line line-one"></span>
          <span class="code-line line-two"></span>
          <span class="code-line line-three"></span>
          <span class="code-line line-four"></span>
        </div>

        <div class="github-copy">
          <h2>Build to learn</h2>
          <p>Prototypes, useful tools, and rabbit holes with a commit history</p>
        </div>

        <span class="card-action">Browse GitHub ↗</span>
      </a>
    </section>
  </main>

  <div id="quest-tooltip" role="tooltip" aria-hidden="true"></div>
</Base>

<script is:inline async src="https://strava-embeds.com/embed.js"></script>

<script>
  /* Strava activities rotate every 8s. Pauses on hover/focus so a reader can
     finish looking, and honours reduced motion by staying on the first one. */
  (() => {
    const rotator = document.querySelector("[data-strava-rotator]");
    if (!rotator) return;
    const slides = [...rotator.querySelectorAll("[data-strava-slide]")];
    const dots = [...document.querySelectorAll("[data-strava-dot]")];
    if (slides.length < 2) return;

    let current = 0;
    let timer = 0;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function show(next) {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) =>
        i === current
          ? slide.setAttribute("data-active", "true")
          : slide.removeAttribute("data-active"),
      );
      dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === current ? "true" : "false"));
    }

    function start() {
      if (reduced || timer) return;
      timer = setInterval(() => show(current + 1), 8000);
    }
    function stop() {
      clearInterval(timer);
      timer = 0;
    }

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        stop();
        start();
      }),
    );

    const card = rotator.closest(".strava-card");
    card?.addEventListener("pointerenter", stop);
    card?.addEventListener("pointerleave", start);
    card?.addEventListener("focusin", stop);
    card?.addEventListener("focusout", start);

    start();
  })();

  const compactNumber = new Intl.NumberFormat("en-US", {
    notation: "compact",
    maximumFractionDigits: 1,
  });

  const streakNumber = document.querySelector("#duo-streak-number");
  const streakLabel = document.querySelector("#duo-streak-label");
  const courseName = document.querySelector("#duo-course");
  const courseXp = document.querySelector("#duo-xp");

  fetch("/api/duolingo")
    .then((response) => {
      if (!response.ok) throw new Error("Profile unavailable");
      return response.json();
    })
    .then((profile) => {
      if (streakNumber && Number.isFinite(profile.streak)) {
        streakNumber.textContent = String(profile.streak);
        streakLabel.textContent = "day streak";
      }

      if (courseName && profile.course?.title) {
        courseName.textContent = profile.course.title;
      }

      const xp = profile.course?.xp ?? profile.totalXp;
      if (courseXp && Number.isFinite(xp)) {
        courseXp.textContent = `${compactNumber.format(xp)} XP`;
      }
    })
    .catch(() => {
      // The public profile link remains the intentional fallback.
    });

  /* Spotify strip on the listening card. The card reads fine without it, so
     every failure path simply leaves the strip hidden. */
  const spotifyLive = document.querySelector("[data-spotify-live]");
  const spotifyArt = document.querySelector("[data-spotify-art]");
  const spotifyStatus = document.querySelector("[data-spotify-status]");
  const spotifyTrack = document.querySelector("[data-spotify-track]");

  const relativeTime = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" });

  function relativeFrom(isoString) {
    const then = new Date(isoString ?? "").getTime();
    if (Number.isNaN(then)) return "recently";

    const minutes = Math.round((then - Date.now()) / 60000);
    if (Math.abs(minutes) < 60) return relativeTime.format(minutes, "minute");

    const hours = Math.round(minutes / 60);
    if (Math.abs(hours) < 24) return relativeTime.format(hours, "hour");

    return relativeTime.format(Math.round(hours / 24), "day");
  }

  fetch("/api/spotify-now")
    .then((response) => {
      if (!response.ok) throw new Error("Spotify unavailable");
      return response.json();
    })
    .then((data) => {
      const playing = data.nowPlaying;
      const latest = data.recentlyPlayed?.[0];
      const track = playing ?? latest;
      if (!track || !spotifyLive) return;

      spotifyStatus.textContent = playing
        ? "Playing now"
        : `Last played ${relativeFrom(latest.playedAt)}`;

      /* textContent, not innerHTML: track and artist names are third-party
         strings and some contain angle brackets. */
      spotifyTrack.textContent = `${track.title} · ${track.artist}`;

      if (spotifyArt && track.art?.small) {
        const cover = document.createElement("img");
        cover.src = track.art.small;
        cover.alt = "";
        cover.width = 48;
        cover.height = 48;
        cover.loading = "lazy";
        spotifyArt.replaceChildren(cover);
      }

      spotifyLive.hidden = false;
    })
    .catch(() => {
      // The card still explains itself and still links to the stats page.
    });

  const tooltip = document.querySelector("#quest-tooltip");
  const finePointer = window.matchMedia(
    "(pointer: fine) and (min-width: 769px)",
  );

  if (tooltip && finePointer.matches) {
    document.querySelectorAll("[data-tooltip]").forEach((card) => {
      card.addEventListener("pointerenter", () => {
        tooltip.textContent = card.getAttribute("data-tooltip") ?? "";
        tooltip.setAttribute("aria-hidden", "false");
        tooltip.classList.add("is-visible");
      });

      card.addEventListener("pointermove", (event) => {
        const gap = 18;
        const tooltipWidth = tooltip.offsetWidth;
        const tooltipHeight = tooltip.offsetHeight;
        const left = Math.min(
          event.clientX + gap,
          window.innerWidth - tooltipWidth - 12,
        );
        const top = Math.min(
          event.clientY + gap,
          window.innerHeight - tooltipHeight - 12,
        );

        tooltip.style.transform = `translate3d(${Math.max(12, left)}px, ${Math.max(12, top)}px, 0)`;
      });

      card.addEventListener("pointerleave", () => {
        tooltip.setAttribute("aria-hidden", "true");
        tooltip.classList.remove("is-visible");
      });
    });
  }
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 12% 8%, rgba(103, 155, 151, 0.08), transparent 25rem),
      #f7f3ec;
  }

  .quests-shell {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .quests-intro {
    max-width: none;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1rem, 2.5vw, 2rem) 0;
    text-align: center;
  }

  .quests-intro h1 {
    margin: 0;
    color: #101b2a;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(4.25rem, 10vw, 8.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .intro-copy {
    max-width: none;
    margin: 1.25rem auto 0;
    color: rgba(16, 27, 42, 0.68);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .intro-copy em {
    color: #427873;
    font-weight: 600;
  }

  .quest-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .quest-card {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid rgba(16, 27, 42, 0.1);
    border-radius: 2rem;
    box-shadow:
      0 20px 45px rgba(16, 27, 42, 0.06),
      inset 0 1px rgba(255, 255, 255, 0.45);
    color: #101b2a;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .quest-card:hover {
    transform: translateY(-5px);
    border-color: rgba(66, 120, 115, 0.35);
    box-shadow:
      0 26px 60px rgba(16, 27, 42, 0.11),
      inset 0 1px rgba(255, 255, 255, 0.5);
  }

  .quest-card:focus-visible,
  .quest-card a:focus-visible {
    outline: 3px solid #66aaa3;
    outline-offset: 5px;
  }

  .external-mark {
    position: absolute;
    z-index: 5;
    top: clamp(1.15rem, 2.5vw, 1.6rem);
    right: clamp(1.15rem, 2.5vw, 1.6rem);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.9rem;
    opacity: 0.5;
  }

  .duo-card {
    grid-column: span 7;
    background: #e5e5e5;
  }

  .duo-copy {
    position: relative;
    z-index: 3;
    width: 52%;
    align-self: flex-end;
    padding: 4rem 0 3rem clamp(1.4rem, 3vw, 2.2rem);
  }

  .duo-streak {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
    color: #e2472f;
  }

  #duo-streak-number {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 850;
    letter-spacing: -0.07em;
    line-height: 0.8;
  }

  #duo-streak-label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .duo-copy h2,
  .notes-copy h2,
  .spotify-copy h2,
  .github-copy h2 {
    margin: 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .duo-copy > p:last-child,
  .notes-copy p,
  .spotify-copy p,
  .github-copy p {
    margin: 0.85rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0.68;
  }

  .duo-avatar {
    position: absolute;
    z-index: 1;
    right: -4%;
    bottom: 0;
    width: 58%;
    height: auto;
    object-fit: contain;
    transform-origin: bottom center;
    animation: duo-float 5.5s ease-in-out infinite;
  }

  .duo-meta {
    position: absolute;
    z-index: 4;
    right: 1.3rem;
    bottom: 1.1rem;
    display: flex;
    gap: 0.35rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(16, 27, 42, 0.12);
    border-radius: 999px;
    background: rgba(247, 243, 236, 0.86);
    color: #101b2a;
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .notes-card {
    grid-column: span 5;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: #ffffff;
  }

  .notes-copy {
    position: relative;
    z-index: 2;
    max-width: 27rem;
    padding-bottom: 3.4rem;
  }

  .card-action {
    position: absolute;
    right: clamp(1.4rem, 3vw, 2.2rem);
    bottom: clamp(1.4rem, 3vw, 2rem);
    left: clamp(1.4rem, 3vw, 2.2rem);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .spotify-card {
    grid-column: span 12;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: #ffffff;
  }

  .spotify-copy {
    max-width: 34rem;
  }

  /* Mirrors the Duolingo card's streak treatment so the two live-data cards
     read as a pair, in teal rather than that card's red. */
  .spotify-headline {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
    color: #427873;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .spotify-headline span {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-variant-numeric: tabular-nums;
    font-weight: 850;
    letter-spacing: -0.07em;
    line-height: 0.8;
  }

  /* Sits above the absolutely positioned card action, hence the bottom
     padding rather than a margin on the action itself. */
  .spotify-live {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.5rem;
    padding-bottom: 3.4rem;
  }

  .spotify-art {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(16, 27, 42, 0.06);
  }

  .spotify-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotify-meta {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spotify-status {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #427873;
  }

  .spotify-track {
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .strava-card {
    grid-column: span 12;
    height: 780px;
    min-height: 780px;
    background: #ffffff;
  }

  .strava-rotator {
    position: absolute;
    inset: 0;
  }

  .strava-embed-shell {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #ffffff;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease-out, ease), visibility 0.5s;
  }

  .strava-embed-shell[data-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  .strava-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    z-index: 3;
    display: flex;
    gap: 9px;
    transform: translateX(-50%);
  }

  .strava-dots button {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .strava-dots button::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(28, 28, 28, 0.28);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .strava-dots button[aria-selected="true"]::before {
    background: #8a1538;
    transform: scale(1.25);
  }

  .strava-dots button:focus-visible { outline: 2px solid #8a1538; outline-offset: 2px; border-radius: 999px; }

  @media (prefers-reduced-motion: reduce) {
    .strava-embed-shell { transition: none; }
  }

  .strava-embed-shell :global(.strava-embed-placeholder) {
    width: 100%;
  }

  .strava-embed-shell :global(iframe) {
    width: 100% !important;
    min-width: 100% !important;
    height: 1220px !important;
    border: 0 !important;
  }

  .github-card {
    grid-column: span 12;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-color: rgba(247, 243, 236, 0.14);
    background:
      linear-gradient(rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
      #101b2a;
    color: #f7f3ec;
  }

  /* The GIF and the code window share one slot: the GIF by default, the code
     window only when reduced motion is requested. pointer-events stays off so
     the frame never steals a click from the card link wrapping it. */
  .gif-frame {
    position: absolute;
    /* Clears the external-mark badge (2rem tall at a 1.15-1.6rem inset) and
       shares its right edge, so the two stack instead of colliding. The old
       code window could sit under the badge because it was translucent. */
    top: 4.2rem;
    right: clamp(1.15rem, 2.5vw, 1.6rem);
    /* Sized by HEIGHT, not width. Width-driven sizing let the derived height
       grow on narrow cards until it covered the heading. */
    height: 13.6rem;
    width: auto;
    aspect-ratio: 480 / 437;
    overflow: hidden;
    border: 1px solid rgba(247, 243, 236, 0.14);
    border-radius: 1rem;
    background: rgba(4, 11, 20, 0.55);
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.23);
    pointer-events: none;
  }

  .gif-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .code-window {
    display: none;
    position: absolute;
    top: 2rem;
    right: 2rem;
    width: min(48%, 19rem);
    height: 8.8rem;
    padding: 1.2rem;
    border: 1px solid rgba(247, 243, 236, 0.14);
