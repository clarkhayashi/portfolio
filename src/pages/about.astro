---
import Base from "../layouts/Base.astro";
import ButtonLink from "../components/ButtonLink.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { lanes } from "../data/lanes";
import ExperienceRow from "../components/ExperienceRow.astro";
import { experience } from "../data/experience";

const mainExperience = experience.filter((e) => !e.background);
const backgroundExperience = experience.filter((e) => e.background);

const buildingNow = [
  "Finishing this portfolio and publishing fuller case studies as the work is ready",
  "Applying for business, marketing, and analytics roles",
  "Helping with listing content while planning local SEO and analytics for my family's real estate business",
  "Keeping up my Japanese, with JLPT N3 as the longer-term goal",
];
---

<Base
  title="About · Clark Hayashi"
  description="One of Bank of Hawaii's first AI interns. Co-founded a student credit union initiative that won $22.5K. Four years running Seattle U intramurals. The full story, rooted in Hawai‘i."
>
  <article class="about-page mx-auto px-6 pb-10 pt-10 md:pt-16">
    <!-- Intro -->
    <section class="about-intro" aria-labelledby="about-title">
      <h1
        id="about-title"
        class="about-title font-serif text-[2.125rem] font-bold leading-[1.04] tracking-[-0.028em] md:text-[3.5rem]"
      >
        About
      </h1>

      <p class="about-hello text-lg text-ink/80">Hi, I'm Clark Hayashi.</p>

      <figure class="about-portrait">
        <img
          src="/images/headshot-cutout.svg"
          alt="Clark Hayashi in a navy suit"
          width="585"
          height="640"
          decoding="async"
        />
      </figure>

      <div class="about-copy space-y-5 leading-relaxed text-ink/80">
        <p>
          I'm a Business Analytics and Marketing graduate from Seattle University
          with a minor in Japanese, born and raised on O‘ahu.
        </p>

        <p>
          I'm a versatile operator. People hand me something new or unfinished
          and I work out how to run it. It started behind a register at the Navy
          Exchange in Honolulu. At Seattle U I officiated intramural sports for
          four years and grew into running the program. I helped found a student
          credit union initiative from nothing. And I spent a summer as one of
          the first AI interns at Bank of Hawaii.
        </p>

        <p>
          AI is a real part of that now and I use it every day. The hard part is
          almost never the model. It is knowing the business well enough to ask
          the right question and being willing to say when an answer is wrong.
          That judgment came from the messier jobs, not from the tools.
        </p>

        <p class="text-sm">
          <span class="font-medium text-teal-deep">In the press</span>
          <br />
          <a
            href="https://www.seattleu.edu/newsroom/2026/experience-by-doing.php"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-teal-deep transition-colors hover:text-ink"
            >Seattle University featured my Bank of Hawaii internship →</a
          >
          <br />
          <a
            href="https://seattlespectator.com/2026/02/04/bouncing-into-a-new-season-of-intramural-basketball/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-teal-deep transition-colors hover:text-ink"
            >The Spectator on running intramural basketball →</a
          >
        </p>
      </div>
    </section>

    <div class="about-body">
    <!-- Professional lanes -->
    <section class="mt-14">
      <h2 class="font-sans text-[1.625rem] font-black tracking-[-0.03em] md:text-[2.125rem]">What I Bring</h2>
      <div class="mt-6">
        {
          lanes.map((lane) => (
            <div class="border-t border-ink/10 py-5">
              <h3 class="font-sans text-[1.125rem] font-bold tracking-[-0.01em]">
                {lane.title}
              </h3>
              <p class="mt-1 leading-relaxed text-ink/70">{lane.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Experience snapshot -->
    <section class="mt-14">
      <h2 class="font-sans text-[1.625rem] font-black tracking-[-0.03em] md:text-[2.125rem]">
        Experience Snapshot
      </h2>
      <p class="mt-3 text-ink/70">
        The full picture, most recent first.
      </p>
      <div class="mt-6">
        {mainExperience.map((item) => <ExperienceRow item={item} />)}
      </div>

      <details class="group mt-8">
        <summary class="cursor-pointer list-none text-[13px] font-medium text-teal-deep transition-colors hover:text-ink">
          <span class="group-open:hidden">Background · sports, culture &amp; first jobs ({backgroundExperience.length} more) ↓</span>
          <span class="hidden group-open:inline">Background ↑</span>
        </summary>
        <div class="mt-4">
          {backgroundExperience.map((item) => <ExperienceRow item={item} />)}
        </div>
      </details>
    </section>

    <WaveDivider />

    <!-- Rooted Perspective -->
    <section class="mt-8">
      <h2 class="font-sans text-[1.625rem] font-black tracking-[-0.03em] md:text-[2.125rem]">
        Rooted Perspective
      </h2>
      <div class="mt-5 space-y-5 leading-relaxed text-ink/80">
        <p>
          I grew up in Hawai‘i, where community isn't a value statement; it's
          just how things get done. Seattle is where I learned to work:
          analytics and marketing classes, a student credit union, four years
          of intramural sports. A semester at 上智大学 (Sophia University) in Tokyo and a
          study tour through Tuscany stretched that further. Being the person
          who doesn't fully speak the language or know the customs teaches you
          to pay close attention.
        </p>
        <p>
          Sports run through all of it: co-captaining my high school varsity
          basketball team, officiating and managing intramural leagues, and
          scrimmaging against a D1 women's basketball team as a practice
          player. None of this shows up on a dashboard, but it shapes how I
          build one. I ask who will actually use the thing, I over-communicate
          rather than assume, and I finish what I start, a habit Scouting
          drilled in early. The question underneath every project stays the
          same: how do I make this clearer, more useful, and more human?
        </p>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        <figure>
          <img
            src="/images/hawaii/hawaii-coast.jpg"
            alt="Coastline in Hawai‘i with mountains meeting the ocean"
            class="aspect-[4/5] w-full rounded-lg object-cover"
            loading="lazy"
            width="480"
            height="600"
          />
          <figcaption class="mt-2 text-[13px] font-medium text-bark">
            Hawai‘i
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/seattle/seattle-space-needle.jpg"
            alt="Seattle skyline with the Space Needle from Gas Works Park"
            class="aspect-[4/5] w-full rounded-lg object-cover"
            loading="lazy"
            width="480"
            height="600"
          />
          <figcaption class="mt-2 text-[13px] font-medium text-bark">
            Seattle
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/japan/tokyo-skytree-dusk.jpg"
            alt="Tokyo skyline with the Skytree at dusk"
            class="aspect-[4/5] w-full rounded-lg object-cover"
            loading="lazy"
            width="480"
            height="600"
          />
          <figcaption class="mt-2 text-[13px] font-medium text-bark">
            Tokyo
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/italy/tuscan-vineyards.jpg"
            alt="Vineyard hills in the Italian countryside at golden hour"
            class="aspect-[4/5] w-full rounded-lg object-cover"
            loading="lazy"
            width="480"
            height="600"
          />
          <figcaption class="mt-2 text-[13px] font-medium text-bark">
            Italy
          </figcaption>
        </figure>
      </div>
      <a
        href="/journey"
        class="mt-6 inline-block font-medium text-teal-deep transition-colors hover:text-ink"
        >Trace the whole journey on the globe →</a
      >
    </section>

    <!-- What I'm building now -->
    <section class="mt-14">
      <h2 class="font-sans text-[1.625rem] font-black tracking-[-0.03em] md:text-[2.125rem]">
        What I'm Working On Now
      </h2>
      <ul class="mt-5 space-y-2.5">
        {
          buildingNow.map((item) => (
            <li class="flex gap-3 leading-relaxed text-ink/70">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Contact -->
    <div class="mt-14 border-t border-ink/10 pt-10">
      <p class="max-w-[58ch] text-lg leading-relaxed text-ink/70">
        I'm looking for roles where analytics, practical judgment, and clear
        communication all matter. If that sounds like your team, I'd love to
        talk.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <ButtonLink href="mailto:hayashiclark@gmail.com">Email me</ButtonLink>
        <ButtonLink
          href="https://www.linkedin.com/in/clark-hayashi"
          variant="ghost"
          external>LinkedIn</ButtonLink
        >
      </div>
    </div>
    </div>
  </article>

  <style>
    .about-page {
      /* Matches the 1000px header container so page content lines up with
         the nav instead of sitting 100px to its left. */
      width: min(1000px, 100%);
    }

    .about-intro {
      display: grid;
      grid-template-areas:
        "title portrait"
        "hello portrait"
        "copy portrait";
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.48fr);
      column-gap: clamp(2rem, 6vw, 5.5rem);
      align-items: start;
    }

    .about-title {
      grid-area: title;
    }

    .about-hello {
      grid-area: hello;
      margin-top: 2rem;
    }

    .about-copy {
      grid-area: copy;
      margin-top: 2rem;
    }

    .about-portrait {
      grid-area: portrait;
      align-self: end;
      margin: 0;
    }

    .about-portrait img {
      display: block;
      width: min(100%, 24rem);
      height: auto;
      margin-inline: auto 0;
    }

    .about-body {
      max-width: 72ch;
    }

    @media (max-width: 767px) {
      .about-intro {
        grid-template-areas:
          "title"
          "hello"
          "portrait"
          "copy";
        grid-template-columns: minmax(0, 1fr);
      }

      .about-hello {
        margin-top: 1.5rem;
      }

      .about-portrait {
        margin-top: 1.5rem;
      }

      .about-portrait img {
        width: min(78vw, 18rem);
        margin-inline: auto;
      }

      .about-copy {
        margin-top: 2rem;
      }
    }
  </style>
</Base>
