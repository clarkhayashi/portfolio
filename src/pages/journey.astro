---
import Base from "../layouts/Base.astro";
import { journey } from "../data/journey";

const stops = journey.map((s) => ({ place: s.place, lon: s.lon, lat: s.lat, years: s.years }));
---

<Base
  title="Journey · Clark Hayashi"
  description="A scroll-driven atlas of the places that shaped how I work: Hawai'i, Seattle, Tokyo, Tuscany, and home again."
>
  <!-- Intro -->
  <section class="mx-auto max-w-[1000px] px-6 pb-10 pt-6 md:pt-12">
    <p class="mb-4 text-[13px] font-medium text-teal-deep">
      The Journey
    </p>
    <h1 class="max-w-[18ch] font-serif text-[2.125rem] font-bold leading-[1.04] tracking-[-0.028em] md:text-[3.5rem]">
      Where I've been
    </h1>
    <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-ink/70">
      One island, one city, two study-abroad chapters, and a loop back home.
      Scroll to travel; click a stop to jump.
    </p>
  </section>

  <!-- Journey -->
  <section class="mx-auto max-w-[1100px] px-4 md:px-6">
    <div class="grid md:grid-cols-2 md:gap-10">
      <!-- Pinned globe -->
      <div class="sticky top-0 z-10 -mx-4 bg-paper px-4 pb-2 pt-2 md:top-16 md:mx-0 md:h-[calc(100vh-8rem)] md:self-start md:bg-transparent md:px-0">
        <div
          id="globe-box"
          data-stops={JSON.stringify(stops)}
          class="mx-auto aspect-square max-h-[28vh] w-auto md:max-h-none md:w-full md:max-w-[520px]"
        >
          <canvas id="globe" class="h-full w-full" aria-hidden="true"></canvas>
        </div>
        <div id="stop-index" class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-1 md:mt-4" role="tablist" aria-label="Journey stops">
        </div>
      </div>

      <!-- Chapters -->
      <div id="chapters" class="pt-8 md:pt-[16vh]">
        {
          journey.map((s, i) => (
            <article
              data-idx={i}
              id={`stop-${i + 1}`}
              class="chapter flex min-h-[78vh] flex-col justify-center border-t border-ink/10 py-14 first:border-t-0 md:min-h-[92vh]"
            >
              <p class="text-[13px] font-medium text-teal-deep">
                Stop 0{i + 1} · {s.placeJa && <span lang="ja">{s.placeJa} · </span>}{s.place}
              </p>
              <h2 class="mt-2 font-sans text-[1.625rem] font-black tracking-[-0.03em] md:text-[2.125rem]">
                {s.titleJa && <span lang="ja">{s.titleJa} · </span>}{s.title}
              </h2>
              <p class="mt-1 font-sans text-[13px] font-medium text-teal-deep">{s.years}</p>
              <p class="mt-4 max-w-[52ch] leading-relaxed text-ink/70">{s.story}</p>
              {s.photo && (
                <img
                  src={s.photo.src}
                  alt={s.photo.alt}
                  class:list={[
                    "mt-6 w-full rounded-xl object-cover",
                    s.photo.portrait ? "aspect-[4/5] max-w-[300px]" : "aspect-[3/2] max-w-[440px]",
                  ]}
                  loading="lazy"
                  width={s.photo.portrait ? 300 : 440}
                  height={s.photo.portrait ? 375 : 293}
                />
              )}
              {s.links && (
                <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1">
                  {s.links.map((l) => (
                    <a
                      href={l.href}
                      {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                      class="text-sm font-medium text-teal-deep transition-colors hover:text-ink"
                    >
                      {l.label} →
                    </a>
                  ))}
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <noscript>
    <p class="mx-auto max-w-[1000px] px-6 py-8 text-ink/70">
      The interactive globe needs JavaScript; the story above reads fine without it.
    </p>
  </noscript>

  <script>
    import { geoGraticule10, geoOrthographic, geoPath } from "d3-geo";

    const D = Math.PI / 180;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canvas = document.getElementById("globe");
    const box = document.getElementById("globe-box");
    const stops = JSON.parse(box.dataset.stops || "[]");
    const ctx = canvas.getContext("2d");

    /* Same palette and draw order as the homepage globe in JourneyStepper, so
       the two read as one object seen twice rather than two different maps. */
    const colors = {
      ocean: "#112D38",
      land: "#E9DFC9",
      coast: "rgba(247,244,239,.72)",
      grid: "rgba(247,244,239,.13)",
      route: "#9BD7D4",
      routeGlow: "rgba(155,215,212,.18)",
      rim: "rgba(247,244,239,.36)",
      /* Markers and labels sit over both dark ocean and light land, so they
         carry a paper ring and a dark halo instead of a flat ink fill. */
      label: "#F7F4EF",
      halo: "rgba(17,45,56,.78)",
      pending: "rgba(247,244,239,.45)",
      active: "#8A1538",
      caption: "rgba(107,86,66,.85)",
    };

    let size = 0, radius = 0, center = 0;
    let viewLon = stops[0].lon, viewLat = stops[0].lat * 0.55;
    let active = 0;
    /* Progress of the single arc into the current stop, reset on every change
       so the line always draws itself in rather than trailing a global count. */
    let legProgress = 0;
    let landGeo = null, graticule = null;

    function resize() {
      const rect = box.getBoundingClientRect();
      const measured = Math.min(rect.width, rect.height || rect.width);
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = measured * dpr;
      canvas.height = measured * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      size = measured;
      radius = measured * 0.42;
      center = measured / 2;
    }

    function projectPoint(lon, lat) {
      const lambda = lon * D, phi = lat * D;
      const lambda0 = viewLon * D, phi0 = viewLat * D;
      const cosc = Math.sin(phi0) * Math.sin(phi) + Math.cos(phi0) * Math.cos(phi) * Math.cos(lambda - lambda0);
      return {
        x: center + radius * Math.cos(phi) * Math.sin(lambda - lambda0),
        y: center - radius * (Math.cos(phi0) * Math.sin(phi) - Math.sin(phi0) * Math.cos(phi) * Math.cos(lambda - lambda0)),
        visible: cosc > 0,
      };
    }

    function slerp(a, b, t) {
      const v = (s) => [Math.cos(s.lat * D) * Math.cos(s.lon * D), Math.cos(s.lat * D) * Math.sin(s.lon * D), Math.sin(s.lat * D)];
      const A = v(a), B = v(b);
      const dot = Math.max(-1, Math.min(1, A[0] * B[0] + A[1] * B[1] + A[2] * B[2]));
      const om = Math.acos(dot);
      if (om < 1e-6) return a;
      const s1 = Math.sin((1 - t) * om) / Math.sin(om), s2 = Math.sin(t * om) / Math.sin(om);
      const P = [A[0] * s1 + B[0] * s2, A[1] * s1 + B[1] * s2, A[2] * s1 + B[2] * s2];
      return { lon: Math.atan2(P[1], P[0]) / D, lat: Math.asin(Math.max(-1, Math.min(1, P[2]))) / D };
    }

    function decodeLand(topo) {
      const transform = topo.transform;
      const arcs = topo.arcs.map((arc) => {
        let x = 0, y = 0;
        return arc.map(([dx, dy]) => {
          x += dx; y += dy;
          return [x * transform.scale[0] + transform.translate[0], y * transform.scale[1] + transform.translate[1]];
        });
      });
      const ring = (ids) => {
        let points = [];
        for (const id of ids) {
          const arc = id < 0 ? arcs[~id].slice().reverse() : arcs[id];
          points = points.concat(points.length ? arc.slice(1) : arc);
        }
        return points;
      };
      const polygons = [];
      const geometries = topo.objects.land.geometries || [topo.objects.land];
      for (const geometry of geometries) {
        if (geometry.type === "Polygon") polygons.push(geometry.arcs.map(ring));
        if (geometry.type === "MultiPolygon") {
          for (const polygon of geometry.arcs) polygons.push(polygon.map(ring));
        }
      }
      return { type: "MultiPolygon", coordinates: polygons };
    }

    /* Vendored, same as the homepage stepper: see public/data/land-110m.json. */
    fetch("/data/land-110m.json")
      .then((r) => r.json())
      .then((topo) => {
        landGeo = decodeLand(topo);
        graticule = geoGraticule10();
      })
      .catch(() => {});

    /* One plain button per place, not per stop. Honolulu and Seattle each
       appear twice in the chronology; listing them twice made the row read as
       a numbered table of contents instead of a map legend. One button per
       place, matching the homepage's chip row.

       Honolulu and Seattle each hold two stops, so a button that only ever
       scrolled to the first left stop 4 (Bank of Hawaii) and stop 6 ("Now")
       reachable by scrolling alone. Each button now steps through its place's
       stops and wraps, so every chapter has a control that reaches it. */
    const chips = document.getElementById("stop-index");
    const stopsForPlace = new Map();
    stops.forEach((s, i) => {
      if (!stopsForPlace.has(s.place)) stopsForPlace.set(s.place, []);
      stopsForPlace.get(s.place).push(i);
    });
    stopsForPlace.forEach((list, place) => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = place;
      b.setAttribute(
        "aria-label",
        list.length > 1 ? `Jump to ${place}, ${list.length} visits` : `Jump to ${place}`,
      );
      b.style.cssText = "border:0;background:none;cursor:pointer;padding:6px 4px;font:500 0.8125rem/1 Satoshi,sans-serif;";
      b.dataset.place = place;
      b.onclick = () => {
        const next = list[(list.indexOf(active) + 1) % list.length];
        document
          .getElementById(`stop-${next + 1}`)
          .scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      };
      chips.appendChild(b);
    });

    function paintChips() {
      const here = stops[active].place;
      [...chips.children].forEach((b) => {
        const seenYet = stopsForPlace.get(b.dataset.place)[0] <= active;
        b.style.color = b.dataset.place === here ? "#8A1538" : seenYet ? "#4F7773" : "rgba(28,28,28,0.4)";
      });
    }

    const io = new IntersectionObserver(
      (es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        const next = +e.target.dataset.idx;
        if (next !== active) legProgress = 0;
        active = next;
        paintChips();
      }),
      { threshold: 0.45 }
    );
    document.querySelectorAll(".chapter").forEach((c) => io.observe(c));

    function easeAngle(cur, tgt, f) {
      const d = ((tgt - cur + 540) % 360) - 180;
      return cur + d * f;
    }

    function draw() {
      const f = reduced ? 1 : 0.045;
      viewLon = easeAngle(viewLon, stops[active].lon, f);
      viewLat += (stops[active].lat * 0.55 - viewLat) * f;
      legProgress += (1 - legProgress) * (reduced ? 1 : 0.06);

      ctx.clearRect(0, 0, size, size);

      const projection = geoOrthographic()
        .translate([center, center])
        .scale(radius)
        .rotate([-viewLon, -viewLat, 0])
        .clipAngle(90)
        .precision(0.45);
      const path = geoPath(projection, ctx);

      ctx.beginPath();
      path({ type: "Sphere" });
      ctx.fillStyle = colors.ocean;
      ctx.fill();

      if (graticule) {
        ctx.beginPath();
        path(graticule);
        ctx.strokeStyle = colors.grid;
        ctx.lineWidth = 0.7;
        ctx.stroke();
      }

      if (landGeo) {
        ctx.beginPath();
        path(landGeo);
        ctx.fillStyle = colors.land;
        ctx.fill("evenodd");
        ctx.strokeStyle = colors.coast;
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      /* Only the hop into the current stop is drawn, same as the homepage.
         Accumulating every leg left a permanent web of lines across the globe
         that competed with the stop the reader is actually on. */
      const leg = Math.max(0, Math.min(1, legProgress));
      if (active > 0 && leg > 0.01) {
        const coordinates = [];
        for (let k = 0; k <= 48; k++) {
          const g = slerp(stops[active - 1], stops[active], (k / 48) * leg);
          coordinates.push([g.lon, g.lat]);
        }
        const route = { type: "LineString", coordinates };
        ctx.lineCap = "round";
        ctx.beginPath();
        path(route);
        ctx.strokeStyle = colors.routeGlow;
        ctx.lineWidth = 7;
        ctx.stroke();
        ctx.beginPath();
        path(route);
        ctx.strokeStyle = colors.route;
        ctx.lineWidth = 2.4;
        ctx.stroke();
      }

      ctx.beginPath();
      path({ type: "Sphere" });
      ctx.strokeStyle = colors.rim;
      ctx.lineWidth = 1.4;
      ctx.stroke();

      const labeled = new Set();
      stops.forEach((s, i) => {
        const p = projectPoint(s.lon, s.lat);
        if (!p.visible) return;
        const isActive = i === active;
        const r = isActive ? 5.5 : 3.5;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fillStyle = isActive ? colors.active : i < active ? colors.route : colors.pending;
        ctx.fill();
        ctx.strokeStyle = "rgba(247,244,239,.9)";
        ctx.lineWidth = isActive ? 1.6 : 1.1;
        ctx.stroke();
        if (!labeled.has(s.place)) {
          labeled.add(s.place);
          ctx.font = `600 ${Math.max(12, radius * 0.062)}px "Satoshi", system-ui, sans-serif`;
          ctx.lineJoin = "round";
          ctx.lineWidth = 3;
          ctx.strokeStyle = colors.halo;
          ctx.strokeText(s.place, p.x + 10, p.y + 4);
          ctx.fillStyle = colors.label;
          ctx.fillText(s.place, p.x + 10, p.y + 4);
        }
      });

      /* The caption sits in the canvas corner, outside the sphere, on paper. */
      ctx.fillStyle = colors.caption;
      ctx.font = `italic 500 ${Math.max(14, radius * 0.082)}px "Satoshi", system-ui, sans-serif`;
      ctx.fillText(`${stops[active].place} · ${stops[active].years}`, 8, 24);

      requestAnimationFrame(draw);
    }

    resize();
    new ResizeObserver(resize).observe(box);
    paintChips();
    requestAnimationFrame(draw);
  </script>
</Base>
