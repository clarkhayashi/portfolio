# Spotify listening stats (/side-quests/listening)
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# The same three variables also go in Vercel under
# Settings > Environment Variables, or the deployed functions return 502.
#
# CLIENT_ID and CLIENT_SECRET come from the app page at
# developer.spotify.com/dashboard. The refresh token is produced once by
# running `npm run spotify:auth` after the first two are set.
#
# The app's registered Redirect URI must be exactly:
#   http://127.0.0.1:3000/callback
# Spotify no longer accepts the hostname `localhost` for this.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
